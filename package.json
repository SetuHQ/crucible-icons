{
    "name"             : "@setu/crucible-icons",
    "version"          : "1.0.20",
    "description"      : "Crucible Icons package",
    "license"          : "MIT",
    "main"             : "./dist/cjs/index.js",
    "module"           : "./dist/esm/index.js",
    "types"            : "./dist/types/src/index.d.ts",
    "sideEffects"      : false,
    "files"            : [
        "dist"
    ],
    "repository"       : {
        "type" : "git",
        "url"  : "https://github.com/SetuHQ/crucible-icons.git"
    },
    "scripts"          : {
        "build:cjs"       : "BABEL_ENV=commonjs babel ./src --config-file ./.babelrc --out-dir ./dist/cjs --extensions .ts,.tsx --copy-files --no-copy-ignored",
        "build:esm"       : "BABEL_ENV=es6 babel ./src --config-file ./.babelrc --out-dir ./dist/esm --extensions .ts,.tsx --copy-files --no-copy-ignored",
        "build:types"     : "tsc --outDir dist/types",
        "prebuild"        : "rimraf dist && node ./scripts/build.js",
        "build"           : "yarn run build:esm && yarn run build:cjs && yarn build:types && prettier --write ./src/**",
        "watch"           : "tsc -w",
        "storybook"       : "storybook dev -p 5555",
        "test"            : "jest",
        "test:watch"      : "jest --watch",
        "test:coverage"   : "jest --coverage",
        "lint"            : "eslint -c .eslintrc.js --ext .ts,.tsx",
        "cz"              : "git cz",
        "build-storybook" : "storybook build -c .storybook -o public",
        "prepare"         : "husky install",
        "pre-commit"      : "prettier --write ./src/** && prettier --write --parser html '**/*.svg'",
        "czcheck"         : "node scripts/no-manual-committing"
    },
    "devDependencies"  : {
        "@babel/cli"                       : "7.18.10",
        "@babel/core"                      : "^7.18.13",
        "@babel/plugin-transform-runtime"  : "^7.18.10",
        "@babel/preset-env"                : "7.18.10",
        "@babel/preset-react"              : "7.18.6",
        "@babel/preset-typescript"         : "^7.18.6",
        "@storybook/addon-docs"            : "10.6.7",
        "@storybook/react-vite"            : "10.6.7",
        "@testing-library/jest-dom"        : "^5.16.5",
        "@testing-library/react"           : "^12.1.2",
        "@types/jest"                      : "29.5.14",
        "@types/node"                      : "20.19.0",
        "@types/react"                     : "17.0.17",
        "@types/react-dom"                 : "17.0.6",
        "@types/react-is"                  : "^17",
        "@types/react-test-renderer"       : "^18.0.0",
        "@types/styled-components"         : "5.1.25",
        "@types/testing-library__jest-dom" : "^5.14.5",
        "@typescript-eslint/eslint-plugin" : "^5.36.2",
        "@typescript-eslint/parser"        : "^5.36.2",
        "babel-jest"                       : "29.7.0",
        "babel-plugin-styled-components"   : "2.0.7",
        "eslint"                           : "8.57.1",
        "eslint-config-next"               : "^12.2.3",
        "eslint-config-prettier"           : "^8.5.0",
        "eslint-plugin-prettier"           : "^4.2.1",
        "eslint-plugin-react"              : "^7.31.1",
        "eslint-plugin-storybook"          : "10.6.7",
        "fictoan-react"                    : "0.41.20",
        "git-cz"                           : "^4.9.0",
        "husky"                            : "^8.0.1",
        "jest"                             : "29.7.0",
        "jest-environment-jsdom"           : "^29.0.1",
        "jest-resolve"                     : "29.7.0",
        "jest-styled-components"           : "7.1.0",
        "prettier"                         : "2.7.1",
        "storybook"                        : "10.6.7",
        "ts-jest"                          : "29.4.5",
        "typescript"                       : "^4.7.4",
        "vite"                             : "8.3.7"
    },
    "dependencies"     : {
        "react"             : "17.0.2",
        "react-dom"         : "17.0.2",
        "react-is"          : "17.0.2",
        "styled-components" : "5.3.0"
    },
    "peerDependencies" : {
        "react"             : ">=17",
        "styled-components" : "^5.3.0"
    },
    "packageManager"   : "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b",
    "resolutions"      : {
        "@joshwooding/vite-plugin-react-docgen-typescript" : "0.9.1",
        "minimatch@npm:^10.2.2"                            : "npm:11.0.1"
    }
}
